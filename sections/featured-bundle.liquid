{% comment %}
  Featured Bundle Section
  - Full-bleed background images (separate desktop and mobile)
  - Headline, subheading, discount pill
  - Add to cart button for a chosen product + a secondary custom button
{% endcomment %}

<section
  id="FeaturedBundle-{{ section.id }}"
  class="featured-bundle color-{{ section.settings.color_scheme }} gradient"
>
  {%- liquid
    assign bundle_product = section.settings.product
    if bundle_product == blank and section.settings.product_handle != blank
      assign bundle_product = all_products[section.settings.product_handle]
    endif
  -%}
  <div class="featured-bundle__bg" aria-hidden="true">
    {% if section.settings.desktop_image != blank %}
      {{
        section.settings.desktop_image
        | image_url: width: 3840
        | image_tag:
          loading: 'lazy',
          widths: '1200, 1600, 2000, 2400, 3000, 3840',
          sizes: '100vw',
          class: 'featured-bundle__bg-image featured-bundle__bg-image--desktop'
      }}
    {% endif %}
    {% if section.settings.mobile_image != blank %}
      {{
        section.settings.mobile_image
        | image_url: width: 2000
        | image_tag:
          loading: 'lazy',
          widths: '600, 900, 1200, 1600, 2000',
          sizes: '100vw',
          class: 'featured-bundle__bg-image featured-bundle__bg-image--mobile'
      }}
    {% elsif section.settings.desktop_image != blank %}
      {{
        section.settings.desktop_image
        | image_url: width: 2000
        | image_tag:
          loading: 'lazy',
          widths: '600, 900, 1200, 1600, 2000',
          sizes: '100vw',
          class: 'featured-bundle__bg-image featured-bundle__bg-image--mobile'
      }}
    {% endif %}
    <div class="featured-bundle__bg-overlay"></div>
  </div>

  <div class="featured-bundle__inner page-width">
    <div class="featured-bundle__content">
      {% if section.settings.discount_label != blank or bundle_product != blank %}
        {% liquid
          assign discount_text = section.settings.discount_label
          if discount_text == blank and bundle_product != blank
            assign v = bundle_product.selected_or_first_available_variant
            if v.compare_at_price > v.price
              assign saving = v.compare_at_price | minus: v.price
              assign pct = saving | times: 100.0 | divided_by: v.compare_at_price | round
              assign discount_text = pct | append: '% off'
            endif
          endif
        %}
        {% if discount_text != blank %}
          <span class="featured-bundle__discount-pill">{{ discount_text }}</span>
        {% endif %}
      {% endif %}

      {% render 'section-title',
        tagline: blank,
        heading: section.settings.heading,
        subheading: section.settings.subheading,
        heading_tag: 'h2',
        heading_class: 'featured-bundle__heading h1',
        subheading_class: 'featured-bundle__subheading rte',
        base_class: 'featured-bundle__header'
      %}

      {% if bundle_product != blank %}
        <div class="featured-bundle__price">
          {% render 'price', product: bundle_product, use_variant: true, show_badges: false %}
        </div>
      {% endif %}

      <div class="featured-bundle__buttons featured-product__buttons">
        {% if bundle_product != blank %}
          <product-form class="product-form">
            {%- form 'product', bundle_product -%}
              <input
                type="hidden"
                name="id"
                value="{{ bundle_product.selected_or_first_available_variant.id }}"
                {% if bundle_product.selected_or_first_available_variant == null
                  or bundle_product.selected_or_first_available_variant.available == false
                %}
                  disabled
                {% endif %}
              >
              <button
                type="submit"
                name="add"
                class="button button--primary"
                {% if bundle_product.selected_or_first_available_variant == null
                  or bundle_product.selected_or_first_available_variant.available == false
                %}
                  disabled
                {% endif %}
              >
                {{ section.settings.add_to_cart_label | default: 'Add to cart' }}
              </button>
            {%- endform -%}
          </product-form>
        {% endif %}

        {% if section.settings.secondary_button_label != blank %}
          <a
            {% if section.settings.secondary_button_link == blank %}
              role="link" aria-disabled="true"
            {% else %}
              href="{{ section.settings.secondary_button_link }}"
            {% endif %}
            class="link product__view-details animate-arrow"
          >
            {{ section.settings.secondary_button_label }}
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" class="icon icon-arrow" viewBox="0 0 14 10">
              <path fill="currentColor" fill-rule="evenodd" d="M8.537.808a.5.5 0 0 1 .817-.162l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 1 1-.708-.708L11.793 5.5H1a.5.5 0 0 1 0-1h10.793L8.646 1.354a.5.5 0 0 1-.109-.546" clip-rule="evenodd"></path>
            </svg>
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</section>

<style>
  #FeaturedBundle-{{ section.id }}.featured-bundle {
    position: relative;
    isolation: isolate;

  }
  #FeaturedBundle-{{ section.id }} .featured-bundle__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  #FeaturedBundle-{{ section.id }} .featured-bundle__bg-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  #FeaturedBundle-{{ section.id }} .featured-bundle__bg-image--mobile { display: none; }
  #FeaturedBundle-{{ section.id }} .featured-bundle__bg-overlay {
    position: absolute;
    inset: 0;
    background: rgba(var(--color-background), 0.0);
  }
  #FeaturedBundle-{{ section.id }} .featured-bundle__inner {
    position: relative;
    z-index: 1;
    padding-top: var(--section-padding-top);
    padding-bottom: var(--section-padding-bottom);
    display: flex;
    flex-direction: row;
    align-items: center;
  }
  #FeaturedBundle-{{ section.id }} .featured-bundle__content {
    max-width: 600px;
  }
  #FeaturedBundle-{{ section.id }} .featured-bundle__discount-pill {
    display: inline-block;
    background: var(--color-orange);
    color: rgb(var(--color-foreground));
    padding: 4px 12px;
    border-radius: 9999px;
    font-weight: 600;
    margin-bottom: 16px;
  }
  #FeaturedBundle-{{ section.id }} .featured-bundle__header { text-align: left;}
  #FeaturedBundle-{{ section.id }} .featured-bundle__heading { margin: 0 0 12px 0; }
  #FeaturedBundle-{{ section.id }} .featured-bundle__subheading { color: rgb(var(--color-foreground), 0.85); }
  #FeaturedBundle-{{ section.id }} .featured-bundle__price { margin: 16px 0 20px 0; }
  #FeaturedBundle-{{ section.id }} .featured-bundle__buttons {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  @media (max-width: 749px) {
    #FeaturedBundle-{{ section.id }} .featured-bundle__bg-image--desktop { display: none; }
    #FeaturedBundle-{{ section.id }} .featured-bundle__bg-image--mobile { display: block; }
    #FeaturedBundle-{{ section.id }} .featured-bundle__content { max-width: 100%; }
  }
</style>

{% schema %}
{
  "name": "Featured bundle",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Background image (desktop)"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Background image (mobile)"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Bundle product"
    },
    {
      "type": "text",
      "id": "product_handle",
      "label": "Bundle product handle (fallback)",
      "info": "Optional. Use if the product picker above doesn’t list your bundle. Enter the product handle."
    },
    {
      "type": "text",
      "id": "discount_label",
      "label": "Discount label",
      "info": "If empty, attempts to calculate from product compare-at price."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Save with our 4 step routine, for best results"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Follow with one or two sentences that expand on your value proposition.</p>"
    },
    {
      "type": "text",
      "id": "add_to_cart_label",
      "label": "Add to cart button label",
      "default": "Add to cart"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Secondary button label",
      "default": "View the routine"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Secondary button link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Featured bundle"
    }
  ]
}
{% endschema %}
