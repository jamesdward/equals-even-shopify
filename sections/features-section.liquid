<section id="Features-{{ section.id }}" class="section features color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    {% if section.settings.heading != blank or section.settings.subheading != blank %}
      <div class="features__header">
        {% if section.settings.tagline != blank %}
          <p class="features__tagline caption-with-letter-spacing">{{ section.settings.tagline }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="features__heading h2">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <div class="features__subheading rte">{{ section.settings.subheading }}</div>
        {% endif %}
      </div>
    {% endif %}

    {%- liquid
      assign columns = section.settings.columns | default: 3
      if columns < 2
        assign columns = 2
      elsif columns > 4
        assign columns = 4
      endif
    -%}

    {% if section.settings.layout == 'image' %}
      <div class="features__split features__split--{{ section.settings.image_position }}">
        {% if section.settings.image != blank %}
          {%- liquid
            assign image_height = section.settings.image.width | divided_by: section.settings.image.aspect_ratio
          -%}
          <div class="features__media">
            {{
              section.settings.image
              | image_url: width: 1500
              | image_tag:
                width: section.settings.image.width,
                height: image_height,
                loading: 'lazy',
                widths: '400, 600, 900, 1200, 1500',
                sizes: '(min-width: 1200px) 600px, (min-width: 750px) 50vw, 100vw',
                class: 'features__image'
            }}
          </div>
        {% endif %}
        <div class="features__list">
          <div class="features__grid features__grid--list">
            {%- for block in section.blocks -%}
              {%- if block.type == 'feature' -%}
                <div class="features__item" {{ block.shopify_attributes }}>
                  <div
                    class="features__icon"
                    style="--icon-size: {{ section.settings.icon_size }}px; {% if section.settings.icon_box_color != blank %}background-color: {{ section.settings.icon_box_color }};{% endif %}"
                  >
                    {% if block.settings.icon != blank %}
                      <i data-lucide="{{ block.settings.icon | escape }}" aria-hidden="true"></i>
                    {% endif %}
                  </div>
                  <div class="features__content">
                    {% if block.settings.title != blank %}
                      <h3 class="features__title h4">{{ block.settings.title }}</h3>
                    {% endif %}
                    {% if block.settings.text != blank %}
                      <div class="features__text rte">{{ block.settings.text }}</div>
                    {% endif %}
                  </div>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      </div>
    {% else %}
      <div class="features__grid features__grid--{{ columns }}">
        {%- for block in section.blocks -%}
          {%- if block.type == 'feature' -%}
            <div class="features__item" {{ block.shopify_attributes }}>
              <div
                class="features__icon"
                style="--icon-size: {{ section.settings.icon_size }}px; {% if section.settings.icon_box_color != blank %}background-color: {{ section.settings.icon_box_color }};{% endif %}"
              >
                {% if block.settings.icon != blank %}
                  <i data-lucide="{{ block.settings.icon | escape }}" aria-hidden="true"></i>
                {% endif %}
              </div>
              <div class="features__content">
                {% if block.settings.title != blank %}
                  <h3 class="features__title h4">{{ block.settings.title }}</h3>
                {% endif %}
                {% if block.settings.text != blank %}
                  <div class="features__text rte">{{ block.settings.text }}</div>
                {% endif %}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {% endif %}
  </div>

  <script>
    (function () {
      var rootEl = document.getElementById('Features-{{ section.id }}');
      if (!rootEl) return;
      function initLucide() {
        if (!window.lucide || !window.lucide.createIcons) return;
        try {
          window.lucide.createIcons(
            { nameAttr: 'data-lucide', attrs: { class: 'features__icon-svg', 'aria-hidden': 'true' } },
            rootEl
          );
        } catch (e) {
          /* ignore */
        }
      }
      if (window.lucide && window.lucide.createIcons) {
        initLucide();
      } else {
        if (!window.__lucideScriptLoading) {
          window.__lucideScriptLoading = true;
          var s = document.createElement('script');
          s.src = 'https://unpkg.com/lucide@0.468.0/dist/umd/lucide.min.js';
          s.async = true;
          s.onload = initLucide;
          document.head.appendChild(s);
        } else {
          var check = setInterval(function () {
            if (window.lucide && window.lucide.createIcons) {
              clearInterval(check);
              initLucide();
            }
          }, 50);
          setTimeout(function () {
            clearInterval(check);
          }, 4000);
        }
      }
      document.addEventListener('shopify:section:load', function (e) {
        if (e && e.detail && e.target && e.target.id === 'shopify-section-{{ section.id }}') {
          initLucide();
        }
      });
    })();
  </script>
</section>

<style>
  /* Features Section */
  .features {
    padding-top: 40px;
    padding-bottom: 40px;
  }

  .features__header {
    max-width: 900px;
    margin: 0 auto 32px auto;
    text-align: center;
  }

  .features__heading {
    margin: 0 0 12px 0;
  }

  .features__tagline {
    margin: 0 0 10px 0;
    color: rgb(var(--color-foreground), 0.7);
  }

  .features__subheading {
    color: rgb(var(--color-foreground), 0.8);
  }

  .features__grid {
    display: grid;
    gap: 24px;
  }

  .features__grid--2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .features__grid--3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .features__grid--4 {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  @media (max-width: 989px) {
    .features__grid--4 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .features__grid--3 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 749px) {
    .features__grid--4,
    .features__grid--3,
    .features__grid--2 {
      grid-template-columns: 1fr;
    }
  }

  .features__item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 16px;
    align-items: start;
    padding: 20px;
    border-radius: var(--radius-base, 8px);
    background: rgb(var(--color-background));
  }

  .features__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px;
    border-radius: var(--radius-base, 8px);
    color: rgb(var(--color-foreground));
  }

  .features__icon-svg {
    width: var(--icon-size, 28px);
    height: var(--icon-size, 28px);
    stroke: currentColor;
    stroke-width: 1.75px;
  }

  .features__title {
    margin: 0 0 6px 0;
  }

  .features__text {
    margin: 0;
    color: rgb(var(--color-foreground), 0.8);
  }

  /* Split layout */
  .features__split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: center;
  }

  .features__split.features__split--right .features__media {
    order: 2;
  }
  .features__split.features__split--right .features__list {
    order: 1;
  }

  .features__media .features__image {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-base, 12px);
  }

  .features__grid--list {
    grid-template-columns: 1fr;
    gap: 16px;
  }

  @media (max-width: 989px) {
    .features__split {
      grid-template-columns: 1fr;
    }
    .features__split .features__media,
    .features__split .features__list {
      order: initial !important;
    }
  }
</style>

{% schema %}
{
  "name": "Features Section",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline (eyebrow)",
      "default": "Our promise"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why choose Equals Even"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Add an optional supporting description here.</p>"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "grid", "label": "Features grid" },
        { "value": "image", "label": "Image with features" }
      ],
      "default": "grid"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Grid columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 16,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "color",
      "id": "icon_box_color",
      "label": "Icon box background color",
      "default": "#F4F4F5"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image (for Image with features layout)"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Lucide icon name",
          "info": "Enter a Lucide icon name, e.g. shield, dumbbell, clock"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Feature title"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Short supporting copy for this feature.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Features Section",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "icon": "shield",
            "title": "Durable materials",
            "text": "<p>Built to last through everyday wear.</p>"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "dumbbell",
            "title": "Performance fit",
            "text": "<p>Comfort and movement without compromise.</p>"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "clock",
            "title": "Timeless design",
            "text": "<p>Styles that stay relevant season after season.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
