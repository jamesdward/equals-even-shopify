{% comment %}
  Video Banner Section
  Based on image-banner, but shows a video instead of an image.
{% endcomment %}

{{ 'section-image-banner.css' | asset_url | stylesheet_tag }}
{%- style -%}
  /* Scope styles to this section instance */
  #Banner-{{ section.id }} .banner__media-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  #Banner-{{ section.id }} .banner__content {
    align-items: center;
    justify-content: center;
  }
  #Banner-{{ section.id }} .banner__heading,
  #Banner-{{ section.id }} .banner__text,
  #Banner-{{ section.id }} .banner__text p {
    color: #ffffff;
  }
{%- endstyle -%}

<section id="Banner-{{ section.id }}" class="banner banner--large">
  <div class="banner__media">
    {% if section.settings.video_url != blank %}
      <video
        class="banner__media-video"
        src="{{ section.settings.video_url }}"
        {% if section.settings.poster_image != blank %}
          poster="{{ section.settings.poster_image | image_url }}"
        {% endif %}
        autoplay
        muted
        loop
        playsinline
      ></video>
    {% elsif section.settings.shopify_video != blank %}
      {{
        section.settings.shopify_video
        | video_tag: autoplay: true, loop: true, muted: true, controls: false, class: 'banner__media-video'
      }}
    {% else %}
      <div class="banner__media-placeholder"></div>
    {% endif %}
  </div>

  {%- liquid
    assign content_position_class = 'middle-center'
    if section.settings.content_position == 'left'
      assign content_position_class = 'middle-left'
    elsif section.settings.content_position == 'right'
      assign content_position_class = 'middle-right'
    endif
  -%}
  <div class="banner__content banner__content--{{ content_position_class }} page-width">
    <div class="banner__box">
      {% if section.settings.heading != blank %}
        <h1 class="banner__heading">{{ section.settings.heading }}</h1>
      {% endif %}
      {% if section.settings.text != blank %}
        <div class="banner__text">{{ section.settings.text }}</div>
      {% endif %}
      {% if section.settings.button_label != blank and section.settings.button_link != blank %}
        <a href="{{ section.settings.button_link }}" class="button button--primary">
          {{ section.settings.button_label }}
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Video banner",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your video hero"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop now"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Content position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "video",
      "id": "shopify_video",
      "label": "Shopify-hosted video",
      "info": "Upload in Settings → Files, then select here."
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "External video URL (MP4)",
      "info": "Used if no Shopify video is selected."
    },
    {
      "type": "image_picker",
      "id": "poster_image",
      "label": "Poster image (fallback)"
    }
  ],
  "presets": [
    {
      "name": "Video banner"
    }
  ]
}
{% endschema %}
