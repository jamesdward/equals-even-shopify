{%- comment -%}
  Reusable section title/header snippet
  Params:
    - tagline: string (optional)
    - heading: string (optional)
    - subheading: richtext/string (optional)
    - heading_tag: default 'h2'
    - heading_class: class to apply to heading element (e.g., 'h2')
    - title_size: optional class to control size (e.g., 'h1', 'h2', 'hxl')
    - subheading_class: class to apply to subheading wrapper
    - tagline_class: class to apply to tagline
    - base_class: wrapper base class (e.g., 'features__header')
    - extra_classes: additional classes for wrapper (e.g., 'features__header--left')
    - style_preset: optional. When 'features', outputs minimal styles matching Features section
{%- endcomment -%}
{%- liquid
  assign wrapper_class = base_class | default: 'section-header'
  if extra_classes != blank
    assign wrapper_class = wrapper_class | append: ' ' | append: extra_classes
  endif
  assign h_tag = heading_tag | default: 'h2'
  assign h_class = heading_class | default: 'h2'
  assign size_class = title_size | default: ''
  assign h_class_final = h_class
  if size_class != blank
    assign h_class_final = h_class_final | append: ' ' | append: size_class
  endif
  assign t_class = tagline_class | default: 'caption-with-letter-spacing'
  assign s_class = subheading_class | default: 'rte'
-%}
{% if style_preset == 'features' %}
  <style>
    .{{ wrapper_class }} {
      max-width: 580px;
      margin: 0 auto 32px auto;
      text-align: center;
    }
    .{{ wrapper_class }} .features__heading { margin: 0 0 12px 0; }
    .{{ wrapper_class }} .features__tagline {
      margin: 0 0 10px 0;
      font-size: 16px;
      font-weight: 600;
      color: rgb(var(--color-foreground), 0.7);
    }
    .{{ wrapper_class }} .features__subheading { color: rgb(var(--color-foreground), 0.8); }
  </style>
{% endif %}
<div class="{{ wrapper_class }}">
  {% if tagline != blank %}
    <p class="{{ t_class }}">{{ tagline }}</p>
  {% endif %}
  {% if heading != blank %}
    <{{ h_tag }} class="{{ h_class_final }}">{{ heading }}</{{ h_tag }}>
  {% endif %}
  {% if subheading != blank %}
    <div class="{{ s_class }}">{{ subheading }}</div>
  {% endif %}
</div>
